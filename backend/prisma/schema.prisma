// AI Health Assistant - Prisma schema (MongoDB)
// Collections: users, health_profiles, conversations, messages,
// symptom_checks, flagged_chats, admin_settings

generator client {
  provider = "prisma-client-py"
  output   = "../prisma_client"
  interface = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("USER") // USER | ADMIN
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        HealthProfile?
  conversations  Conversation[]
  symptomChecks  SymptomCheck[]
  flaggedChats   FlaggedChat[]

  @@map("users")
}

// ------------------------------------------------------- health_profiles
model HealthProfile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  age          Int?
  gender       String?
  heightCm     Float?
  weightKg     Float?
  bloodGroup   String?
  allergies    String[] @default([])
  conditions   String[] @default([])
  medications  String[] @default([])
  activityLevel String?  @default("moderate")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

// ------------------------------------------------------- conversations
model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

// ------------------------------------------------------------ messages
model Message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  role           String // user | assistant | system
  content        String
  flagged        Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ------------------------------------------------------ symptom_checks
model SymptomCheck {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  symptoms        String[] @default([])
  duration        String?
  severity        String? // mild | moderate | severe
  answers         String?
  possibleCauses  String[] @default([])
  selfCare        String[] @default([])
  whenToSeeDoctor String?
  urgency         String   @default("routine") // routine | soon | urgent | emergency
  redFlag         Boolean  @default(false)
  summary         String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("symptom_checks")
}

// -------------------------------------------------------- flagged_chats
model FlaggedChat {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?  @db.ObjectId
  conversationId String?  @db.ObjectId
  messageId      String?  @db.ObjectId
  content        String
  matchedRules   String[] @default([])
  severity       String   @default("high") // high | critical
  source         String   @default("chat") // chat | symptom_check
  reviewed       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("flagged_chats")
}

// -------------------------------------------------------- admin_settings
model AdminSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String   // JSON-encoded string (Prisma Python has no Mongo Json scalar)
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}
