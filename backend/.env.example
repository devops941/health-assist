# ==========================================================
# AI Health Assistant - Backend environment
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================================

# --- MongoDB (Prisma datasource) ---
# MongoDB Atlas connection string. Replace user, password and cluster host.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/healthassistance?retryWrites=true&w=majority"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# --- Groq AI (backend only - never exposed to the frontend) ---
GROQ_API_KEY="gsk_your_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# --- CORS / server ---
FRONTEND_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"

# --- Seed admin ---
ADMIN_EMAIL="admin@healthassistant.ai"
ADMIN_PASSWORD="Admin@12345"
